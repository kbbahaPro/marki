APP_NAME=Marki
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: "log" writes emails to storage/logs. Hostinger: use the SMTP block below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Hostinger email (hPanel → Emails). Use a mailbox on your domain as the sender.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=bookings@yourdomain.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=bookings@yourdomain.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Branding (see config/booking.php). Defaults are the Marki identity;
# set your own to rebrand without touching code.
BRAND_WORDMARK=marki                 # text beside the mark; empty = APP_NAME
BRAND_TAGLINE="Mark that time."
BRAND_PRIMARY="#1D5FAF"               # actions and links (contrast is kept safe automatically)
BRAND_MARKER="#F4A93C"                # the chosen thing: selected date, your time
BRAND_LOGO_URL=                      # absolute URL; replaces the mark and wordmark
BRAND_FAVICON_URL=                   # absolute URL; replaces the built-in favicons
BRAND_SUPPORT_EMAIL=

# Team defaults
DEFAULT_HOST_TIMEZONE=UTC
INVITATION_EXPIRE_DAYS=7

# Google Calendar OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/settings/calendar/google/callback"

# Meetings become "completed" this many minutes after they end (hosts can mark no-shows).
BOOKING_AUTO_COMPLETE_AFTER_MINUTES=60

# Optional CRM integration (DEPLOYMENT.md §11). Webhooks are sent only when
# all three of these are set; generate the id with `php artisan crm:install-id`.
MARKI_INSTALL_ID=
CRM_WEBHOOK_URL=                     # https://crm.example.com/api/v1/integrations/calendar/webhook
CRM_WEBHOOK_SECRET=                  # shown once in the CRM's Settings → Calendar integration
# "Existing customer" badge on booking pages: CRM base URL and a lookup-only API key.
CRM_API_URL=
CRM_API_KEY=
